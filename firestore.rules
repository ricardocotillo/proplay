rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Checks whether the authenticated user is a member of the group.
    function isGroupMember(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    // Checks whether the authenticated user is an owner of the group.
    function isGroupOwner(groupId) {
      return signedIn()
        && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == "owner";
    }

    // Owner or admin of the group (role in the members subcollection).
    function isGroupStaff(groupId) {
      return signedIn()
        && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role in ["owner", "admin"];
    }

    function isSuperUser() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.superUser == true;
    }

    // -------------------------
    // IDENTITY DOCUMENT (DNI / carnet de extranjería)
    // -------------------------
    // Lock id = "{documentType}_{documentNumber}", e.g. "dni_12345678".
    function documentKey(d) {
      return d.documentType + '_' + d.documentNumber;
    }

    // DNI: 8 digits. CE: 9-12 uppercase alphanumerics (lib/utils/document.dart).
    function isValidDocument(d) {
      return d.documentType in ['dni', 'ce']
        && d.documentNumber is string
        && (d.documentType == 'dni'
            ? d.documentNumber.matches('^[0-9]{8}$')
            : d.documentNumber.matches('^[A-Z0-9]{9,12}$'));
    }

    // A new users/{uid} doc must start with zero credits, no admin flag and a
    // valid document whose uniqueness lock is created in the SAME write
    // (transaction/batch) and belongs to the same uid.
    function isValidNewUser(userId, d) {
      return isValidDocument(d)
        && d.superUser == false
        && d.credits == '0.00'
        && !('blockedUntil' in d)
        && !('documentChangedAt' in d)
        && getAfter(/databases/$(database)/documents/documents/$(documentKey(d))).data.uid == userId;
    }

    // The document cannot change after registration (it is what door staff
    // verify, and the lock in documents/ would go out of sync).
    function documentUnchanged() {
      return request.resource.data.get('documentType', '') == resource.data.get('documentType', '')
        && request.resource.data.get('documentNumber', '') == resource.data.get('documentNumber', '');
    }

    // A legacy account (no document yet) may claim one once, with its lock in
    // the SAME write. Changing an existing document stays server-only.
    function documentFirstClaim(userId) {
      return resource.data.get('documentType', '') == ''
        && isValidDocument(request.resource.data)
        && getAfter(/databases/$(database)/documents/documents/$(documentKey(request.resource.data))).data.uid == userId;
    }

    match /documents/{key} {
      // get is needed so the registration transaction can check for an existing lock.
      allow get: if signedIn();
      allow list: if false;

      // Only claimable together with the user's own users/{uid} doc, and only
      // for the exact document that user doc declares (prevents squatting
      // other people's DNI without registering).
      allow create: if signedIn()
        && key.matches('^(dni_[0-9]{8}|ce_[A-Z0-9]{9,12})$')
        && request.resource.data.keys().hasAll(['uid', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.documentType
             + '_'
             + getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.documentNumber == key;

      allow update, delete: if false;
    }

    // -------------------------
    // PUBLIC EVENTS (server-written projection of public liveSessions)
    // -------------------------
    match /publicEvents/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    // -------------------------
    // YAPE
    // -------------------------
    match /yape/{entryId} {
      // Allows any authenticated user to read any document in this collection
      allow read: if signedIn();

      // Restrict writing (create/update/delete) to prevent unauthorized changes
      // If you want users to be able to create entries, change 'false' to 'signedIn()'
      allow write: if false;
    }

    // -------------------------
    // USERS
    // -------------------------
    match /users/{userId} {
      // Option A (public profiles for signed-in users):
      allow read: if signedIn();

      // Needed for sign-up ("create users/{uid}" on register / first Google sign-in).
      allow create: if isOwner(userId) && isValidNewUser(userId, request.resource.data);

      // Only user can edit own profile (the document only once, when it had
      // none: documentFirstClaim). Only a superUser
      // can change superUser (legacy docs without the field count as false),
      // so nobody can promote themselves.
      // credits (saldo) is written only by Cloud Functions (join, cancel,
      // refunds, credit approval), never by any client.
      allow update: if (isOwner(userId) || isSuperUser())
        && (documentUnchanged() || (isOwner(userId) && documentFirstClaim(userId)))
        && request.resource.data.get('credits', '0.00') == resource.data.get('credits', '0.00')
        // blockedUntil (attendance policy) is written only by Cloud Functions.
        && request.resource.data.get('blockedUntil', null) == resource.data.get('blockedUntil', null)
        // documentChangedAt (30-day document cooldown) is written only by the
        // changeDocument function.
        && request.resource.data.get('documentChangedAt', null) == resource.data.get('documentChangedAt', null)
        && (request.resource.data.get('superUser', false) == resource.data.get('superUser', false)
            || isSuperUser());

      // Not the owner: deleting and recreating the doc would drop blockedUntil.
      allow delete: if isSuperUser();

      // user's groups subcollection
      match /groups/{groupId} {
        allow read, write: if isOwner(userId);
      }

      // Missed events (attendance policy): server-written, the user reads their own.
      match /noShows/{eventId} {
        allow read: if isOwner(userId);
      }

      // Web push tokens: one doc per device, id = the FCM token. Only the
      // user manages their own; the functions read them with the admin SDK.
      match /fcmTokens/{token} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['createdAt', 'platform', 'token'])
          && request.resource.data.token == token
          && request.resource.data.createdAt == request.time
          && request.resource.data.platform in ['web', 'android', 'ios'];
      }
    }

    // -------------------------
    // GROUPS
    // -------------------------
    match /groups/{groupId} {
      allow read: if signedIn();
      // createdBy is who may claim the owner role (members create below), so it
      // is set to the creator and never changes.
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;

      allow update: if isGroupMember(groupId)
        && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '');
      allow delete: if isGroupOwner(groupId);

      // Roles here authorize organizer actions (rules and Cloud Functions).
      match /members/{memberId} {
        allow read: if signedIn();

        // Join by code: your own doc as "member". Create group: the creator's
        // own doc as "owner".
        allow create: if isOwner(memberId) && (
          request.resource.data.role == 'member'
          || (request.resource.data.role == 'owner'
              && get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid)
        );

        // Only the group owner grants or changes roles.
        allow update: if isGroupOwner(groupId)
          && request.resource.data.role in ['owner', 'admin', 'member'];

        // The owner removes members; anyone may leave.
        allow delete: if isOwner(memberId) || isGroupOwner(groupId);
      }
    }

    // -------------------------
    // CREDIT HISTORY
    // -------------------------
    match /creditHistory/{id} {
      // User can see their own history
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isSuperUser());

      // A client may only open its own pending Yape top-up. Spends, refunds
      // and approvals are written by Cloud Functions (reviewCreditPurchase,
      // joinSession, cancelParticipation, cancelEvent, removePlayer).
      // spend_* / refund_* ids are the functions' (a squatted refund id
      // would look like a refund already paid).
      allow create: if signedIn()
        && !id.matches('^(spend|refund)_.*')
        && request.resource.data.keys().hasOnly([
            'userId', 'creditAmount', 'amountPaid', 'currency', 'createdAt',
            'status', 'entryType', 'direction', 'sourceType', 'sourceId',
            'transactionId', 'paymentMethod', 'paymentGateway',
            'confirmationCode', 'phoneNumber', 'receiptUrl'
          ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.entryType == 'purchase'
        && request.resource.data.creditAmount is number
        && request.resource.data.creditAmount > 0
        && request.resource.data.amountPaid is number
        && request.resource.data.amountPaid >= request.resource.data.creditAmount
        && request.resource.data.createdAt == request.time
        && request.resource.data.get('direction', 'credit') == 'credit'
        && request.resource.data.get('sourceType', 'payment') == 'payment'
        && request.resource.data.get('currency', 'PEN') == 'PEN';

      allow update, delete: if false;
    }

    // -------------------------
    // SESSION TEMPLATES
    // -------------------------
    match /sessionTemplates/{templateId} {
      // Safest default: only group members can read templates
      allow read: if signedIn() && isGroupMember(resource.data.groupId);

      // Create/update/delete only group owners
      allow create: if signedIn() && isGroupOwner(request.resource.data.groupId);
      allow update, delete: if signedIn() && isGroupOwner(resource.data.groupId);
    }

    // -------------------------
    // LIVE SESSIONS
    // -------------------------
    match /liveSessions/{sessionId} {
      // Someone already holds a seat (the server writes players/playerCount).
      function hasSeats() {
        return resource.data.get('playerCount', 0) != 0 || resource.data.get('players', []).size() != 0;
      }

      // Seats per event: a cancel or auto-cancel refunds every player in one
      // transaction (about 4 writes per player, 500 at most), so the maximum
      // is capped. Same cap as MAX_PLAYERS_LIMIT in lib/utils/min_players.dart.
      // Budget: 4 writes per player, 50 for a full waitlist, 1 for the event,
      // and 5 per late canceller (not capped by the maximum): about 291 at 60
      // players plus the late cancellers, so normal events have wide margin.
      // Lowering the maximum to the player count while a waitlist seat is
      // held can make that person's confirm fail; offers expire in 30 min.
      function validMax(v) {
        return v is int && v >= 1 && v <= 60;
      }

      // The optional minimum: a whole number from 2 up to the maximum.
      function validMin(d) {
        return !('minPlayers' in d)
          || (d.minPlayers is int && d.minPlayers >= 2 && d.minPlayers <= d.get('maxPlayers', 0));
      }

      // Read:
      // - If public session: any signed-in user can read
      // - If private session: only group members can read
      // - The event's creator can always read it (door staff who left the group)
      allow read: if signedIn() && (
        resource.data.isPrivate == false ||
        isGroupMember(resource.data.groupId) ||
        resource.data.get('creatorId', '') == request.auth.uid
      );

      // Create: only group owners (usually from template creation), empty,
      // and as the event's creator.
      allow create: if signedIn() && isGroupOwner(request.resource.data.groupId)
        && request.resource.data.get('playerCount', 0) == 0
        && request.resource.data.get('players', []).size() == 0
        && request.resource.data.get('creatorId', request.auth.uid) == request.auth.uid
        && validMax(request.resource.data.get('maxPlayers', 0))
        && validMin(request.resource.data);

      // Update: only the owner of the session's group, and never groupId,
      // creatorId or the seats. players / playerCount are written only by
      // Cloud Functions (joinSession, cancelParticipation, removePlayer), so a
      // seat always matches a debit and a ticket.
      // diff().affectedKeys() lists only changed fields, so legacy docs without isPrivate work.
      allow update: if signedIn()
        && isGroupOwner(resource.data.groupId)
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['groupId', 'creatorId', 'players', 'playerCount'])
        // The price is frozen once anyone holds a seat: refunds are capped at
        // the current price, so lowering it would short joined players and
        // raising it would pay out more than they paid.
        && (!hasSeats()
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['costPerPlayer']))
        // Once anyone joined, the date is frozen (reminders, the free-cancel
        // promise and the minimum's check all key on it): to reschedule, the
        // organizer cancels (everyone is refunded) and creates a new event.
        && (!hasSeats()
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['eventDate', 'eventEndDate']))
        // The minimum can be lowered or removed after people joined, never raised.
        && (!hasSeats()
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['minPlayers'])
            || request.resource.data.get('minPlayers', 0) <= resource.data.get('minPlayers', 0))
        // The maximum stays within the cap and never below the people who joined.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['maxPlayers'])
            || (validMax(request.resource.data.get('maxPlayers', 0))
                && request.resource.data.get('maxPlayers', 0) >= resource.data.get('playerCount', 0)))
        // A changed minimum or maximum keeps the minimum valid (2 up to the maximum).
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['minPlayers', 'maxPlayers'])
            || validMin(request.resource.data));

      // Delete: only the cancelEvent function (it refunds every player).
      allow delete: if false;

      // Waitlist: server-written (joinWaitlist / leaveWaitlist / joinSession
      // and the offer logic); a user reads only their own entry. lateCancels
      // has no rule: server-only.
      match /waitlist/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
      }
    }

    // -------------------------
    // TICKETS
    // -------------------------
    //
    // Ticket document model (top-level collection, doc id = "{sessionId}_{userId}"):
    //   sessionId: string (required) - the liveSessions doc this ticket is for
    //   groupId: string (required) - must match liveSessions/{sessionId}.groupId
    //   userId: string (required) - the ticket holder; must equal creator's auth.uid
    //   validationToken: string (required) - random token encoded in the QR URL
    //   status: string (required) - "valid" | "used" (a cancelled ticket is deleted by the cancelParticipation function)
    //   createdAt: timestamp (required)
    //   usedAt: timestamp or null - set only when validated
    //   validatedBy: string or null - uid of the validator, set only when validated
    //   eventTitle, sport, userFirstName, userLastName: string (required) - denormalized snapshot
    //   userDocumentType, userDocumentNumber: string - copy of users/{uid}.documentType/Number
    //     (must match the holder's profile: door staff verify the buyer with it)
    //   pricePaid: number (optional, legacy tickets lack it) - amount debited at join; <= the session's costPerPlayer
    //   eventDate, eventEndDate: timestamp (required) - denormalized snapshot
    //   eventLocationAddress, userProfileImageUrl: string or null - denormalized snapshot
    //   eventLocationLat, eventLocationLng: number or null - denormalized snapshot
    //
    match /tickets/{ticketId} {
      // Owner or admin of the ticket's group (checked against the real membership
      // subcollection, same source of truth as isGroupOwner() above, but also
      // recognizes the "admin" role that group owners can grant to members).
      function isGroupOwnerOrAdmin(groupId) {
        return signedIn()
          && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))
          && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role in ["owner", "admin"];
      }

      // A validator (group owner/admin/superUser) flipping a valid ticket to
      // used, and changing nothing else.
      function isValidValidationUpdate(data) {
        return resource.data.status == 'valid'
          && data.status == 'used'
          && data.diff(resource.data).affectedKeys().hasOnly(['status', 'usedAt', 'validatedBy'])
          && data.usedAt is timestamp
          && data.validatedBy == request.auth.uid;
      }

      // The event's creator manages it like a group owner/admin (same rule
      // as canManageEvent in functions/src/adminPolicy.ts).
      function isEventCreator(sessionId) {
        return get(/databases/$(database)/documents/liveSessions/$(sessionId)).data.get('creatorId', '') == request.auth.uid;
      }

      // Read: the ticket holder, an owner/admin of the ticket's group, the
      // event's creator, or a superUser.
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isGroupOwnerOrAdmin(resource.data.groupId) ||
        isEventCreator(resource.data.sessionId) ||
        isSuperUser()
      );

      // Tickets are created and deleted only by Cloud Functions (joinSession,
      // cancelParticipation, cancelEvent, removePlayer).
      allow create: if false;

      // Update: a group owner/admin, the event's creator or a superUser
      // marking a valid ticket used (undo is the checkInPlayer function).
      allow update: if signedIn()
        && (isGroupOwnerOrAdmin(resource.data.groupId) || isEventCreator(resource.data.sessionId) || isSuperUser())
        && isValidValidationUpdate(request.resource.data);

      allow delete: if false;
    }
  }
}
